# Configuration de la Plateforme SPARQL Performance Testing
# Copiez ce fichier vers .env et ajustez les valeurs selon votre environnement

# ==============================================================================
# ENDPOINTS SPARQL
# ==============================================================================

# Virtuoso SPARQL Endpoint
VIRTUOSO_ENDPOINT=http://localhost:8890/sparql

# Jena Fuseki SPARQL Endpoint (Query)
FUSEKI_ENDPOINT=http://localhost:3030/dataset/query

# Jena Fuseki SPARQL Endpoint (Update)
FUSEKI_UPDATE_ENDPOINT=http://localhost:3030/dataset/update

# ==============================================================================
# CONFIGURATION DES TESTS
# ==============================================================================

# Nombre d'itérations par requête
DEFAULT_NUM_ITERATIONS=5

# Nombre d'itérations d'échauffement (warmup)
DEFAULT_WARMUP_ITERATIONS=2

# Niveau de concurrence (nombre de requêtes simultanées)
DEFAULT_CONCURRENT_QUERIES=1

# Type de dataset par défaut (LUBM, DBpedia, BSBM, YAGO, Personnalisé)
DEFAULT_DATASET_TYPE=LUBM

# ==============================================================================
# TIMEOUTS
# ==============================================================================

# Timeout pour les requêtes SPARQL (secondes)
QUERY_TIMEOUT=60

# Timeout pour les tests de connectivité (secondes)
CONNECTIVITY_TIMEOUT=5

# Timeout pour les opérations de synchronisation (secondes)
SYNCHRONIZATION_TIMEOUT=300

# ==============================================================================
# SYNCHRONISATION DES DONNÉES
# ==============================================================================

# Taille des chunks pour la synchronisation (triplets)
# IMPORTANT: Optimisé à 10,000 pour la limite Virtuoso CONSTRUCT (~10K lignes)
# Cette valeur assure une synchronisation à 100% sans perte de données
# Ne pas augmenter au-delà de 10,000 sauf si vous avez modifié la config Virtuoso
SYNC_CHUNK_SIZE=10000

# Nombre maximum de triplets à synchroniser
MAX_SYNC_TRIPLETS=1000000

# Seuil de différence pour déclencher une alerte (%)
AUTO_SYNC_THRESHOLD=0.05

# Activer la sauvegarde automatique avant synchronisation (true/false)
ENABLE_AUTO_BACKUP=true

# ==============================================================================
# LOGGING
# ==============================================================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Niveau de log pour la console
CONSOLE_LOG_LEVEL=INFO

# Répertoire des logs
LOG_DIR=logs

# Nom du fichier de log principal
LOG_FILE=sparql_platform.log

# Taille maximale d'un fichier de log avant rotation (bytes)
LOG_MAX_BYTES=10485760

# Nombre de fichiers de backup à conserver
LOG_BACKUP_COUNT=5

# Activer les couleurs dans la console (true/false)
LOG_COLORED_CONSOLE=true

# ==============================================================================
# MÉTRIQUES ET ALERTES
# ==============================================================================

# Seuil d'alerte pour les gros datasets (triplets)
LARGE_DATASET_THRESHOLD=500000

# Seuil d'alerte mémoire (MB)
MEMORY_WARNING_THRESHOLD=1024

# Collecte des métriques système activée (true/false)
ENABLE_SYSTEM_METRICS=true

# Intervalle de collecte des métriques (secondes)
METRICS_COLLECTION_INTERVAL=1.0

# ==============================================================================
# EXPORT ET RÉSULTATS
# ==============================================================================

# Répertoire pour les résultats exportés
RESULTS_DIR=results

# Répertoire pour les données temporaires
TEMP_DIR=temp

# Format d'export par défaut (csv, excel, json)
DEFAULT_EXPORT_FORMAT=excel

# ==============================================================================
# INTERFACE STREAMLIT
# ==============================================================================

# Port de l'application Streamlit
STREAMLIT_PORT=8501

# Adresse d'écoute (0.0.0.0 pour accepter toutes les connexions)
STREAMLIT_ADDRESS=0.0.0.0

# Titre de l'application
APP_TITLE=Plateforme SPARQL Performance Testing

# Activer le mode debug de Streamlit (true/false)
STREAMLIT_DEBUG=false

# ==============================================================================
# AUTHENTIFICATION DES ENDPOINTS SPARQL
# ==============================================================================

# Virtuoso - Credentials (obligatoire pour les opérations de chargement)
VIRTUOSO_USERNAME=SPARQL
VIRTUOSO_PASSWORD=changeme_virtuoso_password

# Fuseki - Credentials (optionnel, laisser vide si pas d'authentification)
FUSEKI_USERNAME=
FUSEKI_PASSWORD=

# Préfixe URI pour les graphes nommés
DEFAULT_GRAPH_URI_PREFIX=http://example.org/dataset

# ==============================================================================
# SÉCURITÉ APPLICATION (Optionnel)
# ==============================================================================

# Activer l'authentification de l'interface web (true/false)
ENABLE_AUTHENTICATION=false

# Nom d'utilisateur admin (si authentication activée)
ADMIN_USERNAME=admin

# Mot de passe admin (si authentication activée - CHANGER EN PRODUCTION!)
ADMIN_PASSWORD=changeme_admin_password

# ==============================================================================
# DÉVELOPPEMENT
# ==============================================================================

# Mode développement (true/false)
DEV_MODE=false

# Activer le rechargement automatique (true/false)
AUTO_RELOAD=false

# Afficher les warnings Python (true/false)
SHOW_PYTHON_WARNINGS=false
